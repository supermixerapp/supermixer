# Planning documents (local only)
plans/

# Local configuration and secrets
.env.toml

# Build output
/bin/
/web/dist/
/backend/internal/webui/dist/*
!/backend/internal/webui/dist/.gitkeep

# Dependencies and tool caches
node_modules/
/web/.tanstack/
/backend/tmp/
coverage/
*.log
.DS_Store

# Dev Supabase stack (deploy/dev-stacks/up.sh)
/deploy/dev-stacks/.stack/
/deploy/dev-stacks/.src/
# Stacks Supermixer creates in development (provisioning.stacks_dir)
/deploy/dev-stacks/.managed/
/deploy/dev-stacks/.backups/

# Python bytecode (deploy/dev-stacks tests)
__pycache__/

# End-to-end tests (make e2e)
/web/e2e/.tmp/
/web/test-results/
/web/playwright-report/

# Development certificates (deploy/dev-tls/gen.sh)
/deploy/dev-tls/out/

# Go binaries built inside a command's folder (go build ./ there)
/backend/cmd/*/mixer
/backend/cmd/*/supermixer
