# Supermixer configuration. Copy to .env and adjust.
# Real environment variables override values in this file.

# --- Server -------------------------------------------------------------------
# Address the HTTP server listens on.
SUPERMIXER_HTTP_ADDR=:8080
# URL users reach Supermixer at (used for links such as invites).
SUPERMIXER_PUBLIC_URL=http://localhost:8080
# debug | info | warn | error
SUPERMIXER_LOG_LEVEL=info
# Set to true only behind a reverse proxy that sets X-Forwarded-For / X-Real-IP.
# Client IPs are used for sign-in rate limiting and the audit log.
SUPERMIXER_TRUST_PROXY=false

# --- Supermixer's own database -----------------------------------------------
# A dedicated PostgreSQL database, separate from the Supabase stacks it manages.
# deploy/docker-compose.yml starts one on port 5433.
SUPERMIXER_DATABASE_URL=postgres://supermixer:supermixer@localhost:5433/supermixer?sslmode=disable

# --- Security -----------------------------------------------------------------
# 32 random bytes, base64-encoded. Encrypts stored Supabase credentials.
# Generate with: openssl rand -base64 32
# Changing it makes previously stored credentials unreadable.
SUPERMIXER_ENCRYPTION_KEY=
# How long a sign-in lasts.
SUPERMIXER_SESSION_TTL=168h

# Temporary first admin user, created on first start when no users exist.
# Proper admin management replaces this in a later stage.
SUPERMIXER_BOOTSTRAP_ADMIN_USERNAME=admin
SUPERMIXER_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- Appearance ---------------------------------------------------------------
# Brand colour used in place of Supabase green. Default: Piccadilly blue
# (TfL Piccadilly line, Pantone 072). Any #RRGGBB works; shades are derived
# automatically. Takes effect on restart, no rebuild needed.
BRAND_COLOR=#0019A8
# dark | light | system. Users can still change it in the app.
SUPERMIXER_DEFAULT_THEME=dark
