# Supermixer's settings for docker compose. Copy to .env next to compose.yml.

# The version to run: a tag of supermixer/supermixer on Docker Hub.
SUPERMIXER_VERSION=0.1.0

# The host name of this server, as people and apps reach it: Supermixer's web
# app (through nginx) and the stacks' URLs. The certificate must cover it.
SUPERMIXER_DOMAIN=supermixer.example.com

# Optional.
# Where Supermixer keeps its secrets, the certificate, stacks and backups.
#SUPERMIXER_DATA=/var/lib/supermixer
# The port nginx reaches Supermixer on, on 127.0.0.1.
#SUPERMIXER_PORT=8080
